# ─── LLM API Keys ───────────────────────────────────────────
OPENAI_API_KEY= your_openai_key_here
ANTHROPIC_API_KEY=yor_anthropic_key_here

# ─── Model Selection ─────────────────────────────────────────
# Options: "openai" | "anthropic"
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── Embeddings ──────────────────────────────────────────────
# BioMedBERT for medical domain (recommended)
EMBEDDING_MODEL=microsoft/BiomedNLP-BiomedBERT-base-uncased-abstract-fulltext
# Fallback: text-embedding-3-small (OpenAI, faster)
# EMBEDDING_MODEL=text-embedding-3-small

# ─── ChromaDB ────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=pubmed_papers

# ─── PubMed API ──────────────────────────────────────────────
# Get free API key at: https://www.ncbi.nlm.nih.gov/account/
PUBMED_API_KEY=c4a3e54f9e2cba18465293b0bfe6a8138608
PUBMED_EMAIL=balaswapnika.gopi29@gmail.com

# ─── RAG Settings ────────────────────────────────────────────
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.65
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── App Settings ────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
